# Copy this file to .env and fill in your real key.
# NEVER commit .env to git — it is listed in .gitignore.

# Default provider (gemini) — free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Only needed if you switch LLM_PROVIDER to "openai" in finsight/config.py
# OPENAI_API_KEY=sk-your-key-here

# Only needed if you switch LLM_PROVIDER to "anthropic" in finsight/config.py
# ANTHROPIC_API_KEY=sk-ant-your-key-here
